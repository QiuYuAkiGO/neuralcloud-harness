{
  "version": "meeting-v3",
  "maxTokens": 384,
  "temperature": 0,
  "resultItems": {
    "meetingTime": {
      "description": "已查实的会议时间。使用周几几时，例如周三13时。无法确认用 UNKNOWN。",
      "type": "string"
    },
    "reminderStatus": {
      "description": "旧提醒实际状态。UNKNOWN 为待核实，PRESENT 为仍存在，CANCELLED 为已取消。",
      "type": "string",
      "allowed": [
        "UNKNOWN",
        "PRESENT",
        "CANCELLED"
      ]
    },
    "evidenceLabels": {
      "description": "引用的已获准证据编号。只填工具返回的正整数编号，无证据则用空数组。",
      "type": "array",
      "elementType": "integer"
    },
    "impression": {
      "description": "印象摘要与提出者。没有印象时填写无。",
      "type": "string"
    },
    "actionIntent": {
      "description": "交给 Router 的简明行动意图，说明已知结论、需等待的结果和适用的原因。",
      "type": "string"
    },
    "reason": {
      "description": "当前会议时间无法确认的原因。WITHDRAWN 为原更正已撤回，MISMATCH 为查到的数据不匹配，FAILED 为工具异常，EMPTY 为没有可用数据，OTHER 为其他原因。",
      "type": "string",
      "allowed": [
        "WITHDRAWN",
        "MISMATCH",
        "FAILED",
        "EMPTY",
        "OTHER"
      ]
    },
    "confirmMeetingNow": {
      "description": "行动意图是否安排立即确认已核实的会议时间。按实际安排填 true 或 false。",
      "type": "boolean"
    },
    "verifyReminder": {
      "description": "行动意图是否安排核对旧提醒清单或主动取得实际回执。按实际安排填 true 或 false。",
      "type": "boolean"
    },
    "waitReminderResult": {
      "description": "是否等实际结果后再告知旧提醒状态。按实际安排填 true 或 false。",
      "type": "boolean"
    },
    "reportReminderFailure": {
      "description": "是否安排在收到取消失败回执后如实告知。按实际安排填 true 或 false。",
      "type": "boolean"
    },
    "verifyMeetingTime": {
      "description": "行动意图是否明确安排核实会议最终时间。按实际安排填 true 或 false。",
      "type": "boolean"
    }
  },
